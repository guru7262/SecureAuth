# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/secureauth?retryWrites=true&w=majority
MONGODB_DB=secureauth

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=12

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:5173